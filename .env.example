# SafeGate port
SAFEGATE_PORT=8443

# API key for authentication (leave empty to disable auth)
# Use a strong random key of at least 32 characters in production
SAFEGATE_API_KEY=your-secret-api-key-here

# Maximum upload file size in bytes (default: 50MB)
SAFEGATE_MAX_FILE_SIZE=52428800

# ClamAV daemon address
SAFEGATE_CLAMAV_ADDR=clamav:3310
SAFEGATE_CLAMAV_ENABLED=true

# Maximum archive nesting depth (zip bomb protection)
SAFEGATE_MAX_ARCHIVE_DEPTH=3

# Maximum decompressed archive size in bytes (default: 200MB)
SAFEGATE_MAX_ARCHIVE_SIZE=209715200

# Allowed MIME types (comma-separated, leave empty for defaults)
# SAFEGATE_ALLOWED_TYPES=application/pdf,image/jpeg,image/png

# CORS allowed origins (comma-separated, leave empty to block cross-origin)
# Use * only for development; set specific origins in production
# SAFEGATE_CORS_ORIGINS=https://example.com,https://app.example.com

# Rate limiting: max requests per minute per IP (0 = disabled, default: 60)
SAFEGATE_RATE_LIMIT_RPM=60

# Server timeouts in seconds
SAFEGATE_READ_TIMEOUT=30
SAFEGATE_WRITE_TIMEOUT=60
SAFEGATE_IDLE_TIMEOUT=120
SAFEGATE_REQUEST_TIMEOUT=300

# Trusted proxy IPs for X-Forwarded-For parsing (comma-separated)
# SAFEGATE_TRUSTED_PROXIES=10.0.0.1,172.16.0.1

# Etcd configuration (for distributed caching and rate limiting)
SAFEGATE_ETCD_ENABLED=false
SAFEGATE_ETCD_ENDPOINTS=etcd:2379
SAFEGATE_ETCD_DIAL_TIMEOUT=5
SAFEGATE_ETCD_PREFIX=/safegate/

# Scan result cache TTL in seconds (requires etcd)
SAFEGATE_CACHE_TTL=3600
