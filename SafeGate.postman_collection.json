                  "pm.test('Status 204', () => pm.response.to.have.status(204));",
                  "pm.test('No Access-Control-Allow-Origin for unlisted origin', () => {",
                  "    // Unless SAFEGATE_CORS_ORIGINS includes * or evil.com, no CORS header",
                  "    const allowOrigin = pm.response.headers.get('Access-Control-Allow-Origin');",
                  "    pm.expect(allowOrigin).to.be.oneOf([undefined, null]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "https://evil.com"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/scan",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "scan"]
            }
          }
        }
      ]
    },
    {
      "name": "Security",
      "item": [
        {
          "name": "Security headers on every response",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('X-Content-Type-Options is nosniff', () => {",
                  "    pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
                  "});",
                  "pm.test('X-Frame-Options is DENY', () => {",
                  "    pm.expect(pm.response.headers.get('X-Frame-Options')).to.eql('DENY');",
                  "});",
                  "pm.test('Strict-Transport-Security present', () => {",
                  "    pm.expect(pm.response.headers.get('Strict-Transport-Security')).to.include('max-age=');",
                  "});",
                  "pm.test('Content-Security-Policy present', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Security-Policy')).to.include(\"default-src 'none'\");",
                  "});",
                  "pm.test('Referrer-Policy is no-referrer', () => {",
                  "    pm.expect(pm.response.headers.get('Referrer-Policy')).to.eql('no-referrer');",
                  "});",
                  "pm.test('Permissions-Policy present', () => {",
                  "    pm.expect(pm.response.headers.get('Permissions-Policy')).to.include('camera=()');",
                  "});",
                  "pm.test('Cache-Control is no-store', () => {",
                  "    pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "X-Request-ID on every response",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('X-Request-ID header present', () => {",
                  "    const reqId = pm.response.headers.get('X-Request-ID');",
                  "    pm.expect(reqId).to.be.a('string');",
                  "    pm.expect(reqId).to.have.lengthOf(32);",
                  "});",
                  "pm.test('X-Request-ID is unique per request', () => {",
                  "    const reqId = pm.response.headers.get('X-Request-ID');",
                  "    const prev = pm.environment.get('prevRequestId');",
                  "    if (prev) {",
                  "        pm.expect(reqId).to.not.eql(prev);",
                  "    }",
                  "    pm.environment.set('prevRequestId', reqId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Rate limiting – 429 after burst",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// This test verifies the rate limiter returns 429 when the limit is exceeded.",
                  "// To trigger this, set SAFEGATE_RATE_LIMIT_RPM=2 and run this request 3+ times quickly.",
                  "pm.test('Rate limiter responds with 429 or 200', () => {",
                  "    pm.expect([200, 429]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 429) {",
                  "    pm.test('429 includes Retry-After header', () => {",
                  "        pm.expect(pm.response.headers.get('Retry-After')).to.eql('60');",
                  "    });",
                  "    pm.test('429 body format', () => {",
                  "        const body = pm.response.json();",
                  "        pm.expect(body.success).to.be.false;",
                  "        pm.expect(body.message).to.include('Rate limit');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    }
