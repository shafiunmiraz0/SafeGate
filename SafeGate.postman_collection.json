    {
      "name": "Caching (etcd)",
      "item": [
        {
          "name": "Scan same file twice – cache hit on second request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response indicates cached result when etcd enabled', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.true;",
                  "    // When etcd is enabled and the same file was scanned before,",
                  "    // the message will include '(cached)'.",
                  "    // When etcd is disabled, it will be a normal scan result.",
                  "    pm.expect(body.message).to.include('safe');",
                  "    pm.expect(body.data.sha256).to.be.a('string').with.lengthOf(64);",
                  "});",
                  "",
                  "// If etcd caching is active, the second scan of the same file should be faster",
                  "if (pm.response.json().message.includes('cached')) {",
                  "    pm.test('Cached response has (cached) suffix', () => {",
                  "        pm.expect(pm.response.json().message).to.include('(cached)');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "description": "Upload the SAME plain-text .txt file used in 'Scan safe plain-text file' to test cache hit",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/scan",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "scan"]
            }
          }
        }
      ]
